{
  "git": {
    "requireBranch": "main",
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}"
  },
  "github": {
    "release": true,
    "releaseBodyFile": "release-body.txt",
    "assets": [
      "dist/*.exe"
    ]
  },
  "hooks": {
    "before:github:release": "npm run dist:win",
    "after:bump": "npx auto-changelog -p"
  }
}