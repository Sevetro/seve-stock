    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "./types"
    ],
    "jsx": "react-jsx",
  },
  "include": [
    "src/ui",
    "src/electron/shared-with-ui"
  ]
}