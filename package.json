{
  "name": "seve-stock",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Lukasz Gil",
    "email": "lukaszgil7@gmail.com"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron scss:types",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=dev electron .",
    "scss:types": "typed-scss-modules src/ui/**/*.module.scss --exportType named --watch",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc -p src/electron/tsconfig.json",
    "dist:prepare": "rimraf dist && npm run transpile:electron && npm run build",
    "dist:mac": "npm run dist:prepare && electron-builder --mac --arm64",
    "dist:win": "npm run dist:prepare && electron-builder --win --x64",
    "dist:linux": "npm run dist:prepare && electron-builder --linux --x64",
    "release:win": "node ./scripts/release-win.js"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "releaseName - v${version}",
      "assets": [
        "dist/seve-stock_${version}.exe"
      ]
    },
    "hooks": {
      "after:bump": "npm run dist:win"
    }
  },
  "dependencies": {
    "@ariakit/react": "^0.4.19",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lightweight-charts": "^5.0.9",
    "match-sorter": "^8.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yahoo-finance2": "^3.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.0.0",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "npm-run-all": "^4.1.5",
    "release-it": "^19.0.6",
    "rimraf": "^6.1.2",
    "sass-embedded": "^1.93.3",
    "typed-scss-modules": "^8.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
